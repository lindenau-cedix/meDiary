<?xml version="1.0" encoding="utf-8"?>
<!--
  Provider metadata for the 1×1 “meDiary Sample” home-screen widget.

  A 1×1 cell means minWidth/minHeight must be considerably smaller than a
  typical launcher cell (~70dp), so the picker occupies exactly one cell.
  On modern launchers, `targetCellWidth`/`targetCellHeight` = 1 provides an
  explicit size (Android 12+); `minWidth`/`minHeight` remains the fallback
  for older launchers.

  updatePeriodMillis = 0 means there is no automatic refresh loop. The widget
  renders only when needed (onUpdate after adding, onAppWidgetOptionsChanged,
  or after a configuration change via `SampleWidgetProvider.updateAppWidget`).

  `configure` launches `SampleWidgetConfigActivity` as the first placement
  step—the system creates the widget only AFTER the activity returns RESULT_OK.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_sample"
    android:previewImage="@drawable/widget_preview"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:configure="app.mediary.widget.SampleWidgetConfigActivity" />
