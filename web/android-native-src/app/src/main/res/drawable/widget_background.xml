<?xml version="1.0" encoding="utf-8"?>
<!--
  Background shape for the widget tile. It defines only the rounded corners
  (12dp); the provider sets the fill color at runtime for each instance
  (substance color from `GET /api/substances`, falling back to the slot color
  from `colors.xml`).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
</shape>
